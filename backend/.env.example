APP_NAME=CityU Credential Chain API
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=mysql+pymysql://unicredential:change-me@127.0.0.1:3306/unicredential?charset=utf8mb4
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

# Comma-separated fallback issuer wallets for local development.
ISSUER_WALLETS=

# Fill these after deploying from Remix to Sepolia.
WEB3_RPC_URL=
CHAIN_ID=11155111
CREDENTIAL_CONTRACT_ADDRESS=
DISCLOSURE_CONTRACT_ADDRESS=

# Administrators and activity creators sign contract writes in MetaMask.
# Never place a wallet private key in this file.
